---
import "../styles/global.css";

interface Props {
  chrome?: boolean;
}

const { chrome = true } = Astro.props;
const path = Astro.url.pathname;

const navLinks = [
  { href: "/tools/", label: "Free tools" },
  { href: "/connect/", label: "Connect" },
  { href: "/cogs/", label: "COGS" },
  { href: "/dashboard/", label: "Dashboard" },
];

// Public content pages that must not carry the prototype disclaimer — it
// undermines trust on pages meant to rank and be shared.
const APP_PROTOTYPE_PATHS = ["/connect/", "/cogs/", "/dashboard/"];
const isAppPrototype = APP_PROTOTYPE_PATHS.some(
  (p) => path === p || path === p.slice(0, -1),
);

// Footer links to every indexable content page, so no tool or guide is an
// orphan regardless of which page a crawler lands on first.
const footerLinks = [
  { href: "/tools/", label: "Free tools" },
  { href: "/tiktok-shop-fee-calculator/", label: "Fee calculator" },
  { href: "/tiktok-shop-break-even-calculator/", label: "Break-even price" },
  { href: "/tiktok-shop-roas-calculator/", label: "Break-even ROAS" },
  { href: "/tiktok-shop-payout-schedule/", label: "Payout schedule" },
  {
    href: "/why-tiktok-shop-payout-is-less-than-sales/",
    label: "GMV vs settlement",
  },
];

const isActive = (href: string) => path === href || path === `${href}/`;
const baseLink = "px-3 py-2 rounded-md transition";
const idleLink = `${baseLink} text-muted-foreground hover:text-foreground hover:bg-muted`;
const activeLink = `${baseLink} text-foreground bg-muted`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
    />
    <slot name="head" />
  </head>
  <body>
    {
      chrome ? (
        <div class="min-h-screen bg-background text-foreground flex flex-col">
          <header class="border-b border-border bg-background/80 backdrop-blur sticky top-0 z-30">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
              <a href="/" class="flex items-center gap-2 font-semibold tracking-tight">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="24"
                    height="24"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    class="h-4 w-4"
                  >
                    <path d="M16 7h6v6" />
                    <path d="m22 7-8.5 8.5-5-5L2 17" />
                  </svg>
                </span>
                <span>MarginReady</span>
              </a>
              <nav class="hidden sm:flex items-center gap-1 text-sm">
                {navLinks.map((l) => (
                  <a href={l.href} class={isActive(l.href) ? activeLink : idleLink}>
                    {l.label}
                  </a>
                ))}
              </nav>
            </div>
          </header>
          <main class="flex-1">
            <slot />
          </main>
          <footer class="border-t border-border">
            <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-8">
              <nav
                aria-label="Free TikTok Shop tools and guides"
                class="flex flex-wrap gap-x-5 gap-y-2 text-xs text-muted-foreground"
              >
                {footerLinks.map((l) => (
                  <a class="hover:text-foreground hover:underline" href={l.href}>
                    {l.label}
                  </a>
                ))}
              </nav>
              <div class="mt-5 pt-5 border-t border-border text-xs text-muted-foreground flex flex-col sm:flex-row gap-2 sm:items-center sm:justify-between">
                <span>© 2026 MarginReady. Built for TikTok Shop sellers.</span>
                {isAppPrototype && <span>Frontend prototype · mock data</span>}
              </div>
            </div>
          </footer>
        </div>
      ) : (
        <slot />
      )
    }
  </body>
</html>
