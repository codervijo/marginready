---
import Layout from "../layouts/Layout.astro";

const site = "https://marginready.com";
const path = "/tools/";
const url = site + path;
const title = "Free TikTok Shop Seller Calculators & Guides — MarginReady";
const description =
  "Which TikTok Shop calculator to use first and how the numbers chain: landed COGS, fees and net profit, break-even price, break-even ROAS, FBT, payouts.";

const tools = [
  {
    href: "/tiktok-shop-fee-calculator/",
    name: "TikTok Shop Fee Calculator",
    blurb:
      "Enter a price you have already set and see net profit, net margin, and TikTok's effective take after every fee.",
    tag: "Calculator",
  },
  {
    href: "/tiktok-shop-break-even-calculator/",
    name: "Break-Even Price Calculator",
    blurb:
      "Work backwards from your costs to the lowest price that doesn't lose money — and the price you need for your target margin.",
    tag: "Calculator",
  },
  {
    href: "/tiktok-shop-roas-calculator/",
    name: "Break-Even ROAS Calculator",
    blurb:
      "Find the ROAS your ads actually need, the max you can pay per order, and what your current ROAS really earns.",
    tag: "Calculator",
  },
  {
    href: "/tiktok-shop-fbt-fee-calculator/",
    name: "FBT Fee Calculator",
    blurb:
      "Chargeable weight, storage after the free 60 days, and return handling — the all-in Fulfilled by TikTok cost per unit, versus shipping it yourself.",
    tag: "Calculator",
  },
  {
    href: "/how-to-calculate-cogs-tiktok-shop/",
    name: "How to Calculate COGS",
    blurb:
      "Landed cost per sellable unit from one purchase order — and which costs belong in COGS versus your TikTok settlement.",
    tag: "Guide",
  },
  {
    href: "/tiktok-shop-payout-schedule/",
    name: "TikTok Shop Payout Schedule",
    blurb:
      "Estimate the date your money lands, and why: delivery-based settlement, settlement tiers, the reserve, and payout schedules.",
    tag: "Guide",
  },
  {
    href: "/why-tiktok-shop-payout-is-less-than-sales/",
    name: "Why Your Payout Is Less Than Your Sales",
    blurb:
      "Every deduction between GMV and settlement, including the platform-discount trap most sellers never notice.",
    tag: "Guide",
  },
];

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Free TikTok Shop Seller Calculators & Guides",
  url,
  description,
  isPartOf: { "@id": "https://marginready.com/#website" },
  hasPart: tools.map((t) => ({
    "@type": t.tag === "Calculator" ? "WebApplication" : "Article",
    name: t.name,
    url: site + t.href,
  })),
};
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="MarginReady" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
  </Fragment>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
        Free TikTok Shop seller tools
      </h1>
      <p class="mt-4 text-muted-foreground max-w-2xl">
        Calculators and plain-English guides for the money questions TikTok Shop
        never answers directly: what a product really costs you, what you keep
        at a given price, the lowest price that doesn&rsquo;t lose money, whether
        your ads pay for themselves, and when and why the payout arrives. They
        work best in order, because each one&rsquo;s answer is an input to the
        next. No signup, no email — every calculator runs in your browser on
        numbers you type in.
      </p>
    </header>

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        tools.map((t) => (
          <li>
            <a
              href={t.href}
              class="group flex h-full flex-col rounded-2xl border border-border bg-card shadow-card p-5 transition hover:border-primary/40 hover:shadow-md"
            >
              <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                {t.tag}
              </span>
              <span class="mt-2 font-semibold tracking-tight text-foreground group-hover:text-primary">
                {t.name}
              </span>
              <span class="mt-2 text-sm text-muted-foreground">{t.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="prose-tk mt-12 max-w-2xl space-y-12">
      <section>
        <h2 class="text-xl font-semibold tracking-tight">
          Work through them in this order
        </h2>
        <p class="mt-3 text-muted-foreground">
          Most sellers open the fee calculator first and type in their supplier
          price. That gets every later answer wrong, because the cost you
          enter carries through all of them. This order fixes that:
        </p>
        <ol class="mt-4 list-decimal space-y-4 pl-5 text-muted-foreground">
          <li>
            <a class="underline hover:text-foreground" href="/how-to-calculate-cogs-tiktok-shop/"
              ><strong class="text-foreground">Work out your landed COGS.</strong></a
            >
            &ldquo;Product cost / COGS per unit&rdquo; is an input on every
            calculator here, and the supplier price is the wrong number for it.
            Freight, duties, packaging, inbound shipping and the units that
            arrive unsellable all belong in it. You come away with one figure:
            cost per sellable unit.
          </li>
          <li>
            <a class="underline hover:text-foreground" href="/tiktok-shop-fbt-fee-calculator/"
              ><strong class="text-foreground">If you use FBT, cost it per unit.</strong></a
            >
            The FBT calculator turns your rate card and box size into one
            all-in fulfillment cost per unit, including storage and returns.
            That&rsquo;s the &ldquo;fulfillment per unit&rdquo; input in the next
            three steps. If you ship orders yourself, use your label cost
            instead and skip this step.
          </li>
          <li>
            <a class="underline hover:text-foreground" href="/tiktok-shop-fee-calculator/"
              ><strong class="text-foreground">Check what a price leaves you.</strong></a
            >
            At a price you already charge or plan to, the fee and profit
            calculator shows net profit per order after the referral fee,
            creator commission, fulfillment, returns and ad spend. If that
            number is negative, go to step 4 before you sell another unit.
          </li>
          <li>
            <a class="underline hover:text-foreground" href="/tiktok-shop-break-even-calculator/"
              ><strong class="text-foreground">Find the price that works.</strong></a
            >
            The break-even calculator runs the same math backwards: from your
            costs to the lowest price that doesn&rsquo;t lose money, and the
            price you need for a target margin.
          </li>
          <li>
            <a class="underline hover:text-foreground" href="/tiktok-shop-roas-calculator/"
              ><strong class="text-foreground">Only then, set your ad targets.</strong></a
            >
            With a price settled, the ROAS calculator gives the return your ads
            must reach to break even and the most you can pay per order. Set
            them before the price is settled and they&rsquo;ll be wrong as soon
            as the price changes, because the margin they come from changes
            with it.
          </li>
          <li>
            <a class="underline hover:text-foreground" href="/tiktok-shop-payout-schedule/"
              ><strong class="text-foreground">Plan cash around the payout schedule.</strong></a
            >
            A profitable sale still pays out days or weeks later: settlement starts at
            delivery, your tier sets the speed, and a reserve is held back.
            Restock against when the money lands, not against the sale.
          </li>
          <li>
            <a class="underline hover:text-foreground" href="/why-tiktok-shop-payout-is-less-than-sales/"
              ><strong class="text-foreground">Reconcile what arrives.</strong></a
            >
            When the payout is smaller than your sales figure, the GMV vs
            settlement guide walks every deduction between the two, so you can
            tell a normal gap from a real problem.
          </li>
        </ol>
      </section>

      <section>
        <h2 class="text-xl font-semibold tracking-tight">
          Three calculators, one set of numbers
        </h2>
        <p class="mt-3 text-muted-foreground">
          The fee, break-even and ROAS calculators take the same inputs (COGS,
          referral fee, creator commission, fulfillment and return rate) and
          answer the same question from different ends. The fee calculator goes
          from a price to a profit. Break-even goes from a target margin to a
          price. ROAS goes from a price to the most your ads can spend.
        </p>
        <p class="mt-3 text-muted-foreground">
          Enter the same numbers in all three and they agree: put the
          break-even price into the fee calculator and net profit comes out at
          zero, and the same is true at the break-even ROAS. If your answers
          don&rsquo;t line up, one of the inputs differs between them, and
          finding which one is usually the useful part.
        </p>
      </section>

      <section>
      <h2 class="text-xl font-semibold tracking-tight">
        Estimates are a starting point, not an answer
      </h2>
      <p class="mt-3 text-muted-foreground">
        Every tool here models your numbers — useful before you list a product,
        or when you are deciding whether a campaign can work. But modeled fees
        are not the fees TikTok charged you.
      </p>
      <p class="mt-3 text-muted-foreground">
        <a class="underline hover:text-foreground" href="/">MarginReady</a>
        connects to your TikTok Shop account, reads your actual settled transactions,
        subtracts the cost per unit you enter, and shows true profit and margin for
        every SKU — from real settled payouts, not estimates.
      </p>
      </section>
    </div>
  </div>
</Layout>
