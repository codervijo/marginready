---
import Layout from "../layouts/Layout.astro";

const site = "https://marginready.com";
const path = "/tools/";
const url = site + path;
const title = "Free TikTok Shop Seller Calculators & Guides — MarginReady";
const description =
  "Free calculators and guides for TikTok Shop sellers: fee and net profit calculator, break-even price calculator, break-even ROAS calculator, payout schedule, and GMV vs settlement explained.";

const tools = [
  {
    href: "/tiktok-shop-fee-calculator/",
    name: "TikTok Shop Fee Calculator",
    blurb:
      "Enter a price you have already set and see net profit, net margin, and TikTok's effective take after every fee.",
    tag: "Calculator",
  },
  {
    href: "/tiktok-shop-break-even-calculator/",
    name: "Break-Even Price Calculator",
    blurb:
      "Work backwards from your costs to the lowest price that doesn't lose money — and the price you need for your target margin.",
    tag: "Calculator",
  },
  {
    href: "/tiktok-shop-roas-calculator/",
    name: "Break-Even ROAS Calculator",
    blurb:
      "Find the ROAS your ads actually need, the max you can pay per order, and what your current ROAS really earns.",
    tag: "Calculator",
  },
  {
    href: "/tiktok-shop-payout-schedule/",
    name: "TikTok Shop Payout Schedule",
    blurb:
      "When you actually get paid: delivery-based settlement, the five tiers, the 30-day reserve, and the $1 minimum.",
    tag: "Guide",
  },
  {
    href: "/why-tiktok-shop-payout-is-less-than-sales/",
    name: "Why Your Payout Is Less Than Your Sales",
    blurb:
      "Every deduction between GMV and settlement, including the platform-discount trap most sellers never notice.",
    tag: "Guide",
  },
];

const collectionLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Free TikTok Shop Seller Calculators & Guides",
  url,
  description,
  isPartOf: { "@id": "https://marginready.com/#website" },
  hasPart: tools.map((t) => ({
    "@type": t.tag === "Calculator" ? "WebApplication" : "Article",
    name: t.name,
    url: site + t.href,
  })),
};
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="MarginReady" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(collectionLd)} />
  </Fragment>

  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
        Free TikTok Shop seller tools
      </h1>
      <p class="mt-4 text-muted-foreground max-w-2xl">
        Calculators and plain-English guides for the money questions TikTok Shop
        never answers directly. No signup, no email — every calculator runs in
        your browser on numbers you type in.
      </p>
    </header>

    <ul class="grid gap-4 sm:grid-cols-2">
      {
        tools.map((t) => (
          <li>
            <a
              href={t.href}
              class="group flex h-full flex-col rounded-2xl border border-border bg-card shadow-card p-5 transition hover:border-primary/40 hover:shadow-md"
            >
              <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">
                {t.tag}
              </span>
              <span class="mt-2 font-semibold tracking-tight text-foreground group-hover:text-primary">
                {t.name}
              </span>
              <span class="mt-2 text-sm text-muted-foreground">{t.blurb}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <div class="prose-tk mt-12 max-w-2xl">
      <h2 class="text-xl font-semibold tracking-tight">
        Estimates are a starting point, not an answer
      </h2>
      <p class="mt-3 text-muted-foreground">
        Every tool here models your numbers — useful before you list a product,
        or when you are deciding whether a campaign can work. But modeled fees
        are not the fees TikTok charged you.
      </p>
      <p class="mt-3 text-muted-foreground">
        <a class="underline hover:text-foreground" href="/">MarginReady</a>
        connects to your TikTok Shop account, reads your actual settled transactions,
        subtracts the cost per unit you enter, and shows true profit and margin for
        every SKU — from real settled payouts, not estimates.
      </p>
    </div>
  </div>
</Layout>
