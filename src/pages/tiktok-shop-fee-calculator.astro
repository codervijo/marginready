---
import Layout from "../layouts/Layout.astro";
import { TikTokFeeCalculator } from "../components/TikTokFeeCalculator";

const site = "https://marginready.com";
const path = "/tiktok-shop-fee-calculator/";
const url = site + path;
const title = "TikTok Shop Fee & Profit Calculator — Net Profit Per Order";
const description =
  "Enter your price, COGS, affiliate rate, shipping and ad spend to see what you keep per order on TikTok Shop after the 6% referral fee and every other cost.";

// Fee facts verified against TikTok Shop Seller Center. Update when re-verified.
const verifiedAsOf = "September 2026";

const REFERRAL_FEES_URL =
  "https://seller-us.tiktok.com/university/essay?knowledge_id=5988482086864682";
const SELLER_TERMS_URL =
  "https://seller-us.tiktok.com/university/essay?knowledge_id=1331308753078058&lang=en";
const REFERRAL_TAX_URL =
  "https://seller-us.tiktok.com/university/essay?knowledge_id=1017269682849550&lang=en";
const SHIPPING_REVERSAL_URL =
  "https://www.modernretail.co/operations/tiktok-halts-plan-to-end-independent-shipping-for-u-s-sellers-after-backlash/";

const faq = [
  {
    q: "How much does TikTok Shop take per sale?",
    a: "TikTok's own cut is the referral fee: 6% of what the buyer pays in most US categories, 5% in five jewelry subcategories. What the channel takes in total depends on your affiliate rate, shipping, returns and ads. A $20 product with a 20% creator commission and $4 shipping loses 46% of its revenue before product cost. Enter your numbers above to see your own figure.",
  },
  {
    q: "What is the TikTok Shop referral fee in the US?",
    a: "6% for most categories. Five jewelry subcategories (Diamond, Gold, Jade, Platinum/Carat Gold, Ruby/Sapphire/Emerald) pay 5%, and pre-owned categories have their own rates. TikTok can change the fee and says it will notify sellers by email or in Seller Center, so check your category's rate there.",
  },
  {
    q: "Is there a separate payment processing fee on TikTok Shop?",
    a: "Not from TikTok. Its Seller Terms describe the referral fee as covering the platform, including the services that let payment providers process payments for you. So don't add a separate card-processing percentage to your model the way you would on some other platforms.",
  },
  {
    q: "Do I pay sales tax on the TikTok Shop referral fee?",
    a: "Only if your business is registered in Texas or West Virginia. Since November 1, 2025, TikTok collects sales tax on the referral fee for sellers there and adds it to the referral fee on your seller invoice. Everywhere else, no.",
  },
  {
    q: "What is the difference between fees and net profit on TikTok Shop?",
    a: "Fees are what TikTok and your creators take: referral fee, affiliate commission, and FBT if you use it. Net profit is what's left after those and your own costs: product cost (COGS), shipping, returns and ads. A product can have normal fees and still lose money if COGS or ad spend is too high, so this calculator ends on net profit, not fees.",
  },
];

const webApplicationLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "TikTok Shop Fee & Profit Calculator",
  url,
  description:
    "Calculate net profit per order and net margin on TikTok Shop after the referral fee, affiliate commissions, fulfillment or shipping, returns, and ad spend.",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  publisher: { "@id": "https://marginready.com/#organization" },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const link = "underline hover:text-foreground";
const ext = { rel: "nofollow noopener", target: "_blank" };
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="MarginReady" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webApplicationLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <header class="mb-6">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
        TikTok Shop fee calculator: what you keep per order
      </h1>
      <p class="mt-3 text-muted-foreground max-w-2xl">
        TikTok Shop charges a 6% referral fee on most US orders. Once you add
        creator commissions, shipping, returns and ads, it&rsquo;s often not
        the biggest cost on the order. Enter your numbers to see net
        profit per order, net margin, and how much of each sale goes to
        costs other than your product.
      </p>
      <p class="mt-3 text-xs text-muted-foreground">
        Fee facts checked against TikTok Seller Center, {verifiedAsOf}. The 6%
        default comes from TikTok&rsquo;s
        <a class={link} href={REFERRAL_FEES_URL} {...ext}>referral fee page</a>;
        confirm your category there. This estimator uses your inputs. It
        does not read your account.
      </p>
    </header>

    <TikTokFeeCalculator client:load />

    <div class="prose-tk mt-14 space-y-12 max-w-3xl">
      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          What TikTok Shop charges, and what it doesn&rsquo;t
        </h2>
        <p class="mt-3 text-muted-foreground">
          TikTok itself charges one fee on every sale, the
          <strong class="text-foreground">referral fee</strong>. In the US
          it&rsquo;s <strong class="text-foreground">6%</strong> in most
          categories, with 5% for five jewelry subcategories (Diamond, Gold,
          Jade, Platinum/Carat Gold, Ruby/Sapphire/Emerald). It&rsquo;s
          calculated on the total amount the buyer pays. It also covers the
          services that let payment providers process the payment, so there is
          no separate processing fee from TikTok to add.
        </p>
        <p class="mt-3 text-muted-foreground">
          One exception: if your business is registered in
          <strong class="text-foreground">Texas or West Virginia</strong>,
          TikTok has added sales tax to the referral fee on your seller invoice
          since November 1, 2025. In those states the fee is slightly higher
          than 6%.
        </p>
        <p class="mt-3 text-muted-foreground">
          Everything else in the calculator is a cost you choose or cause:
        </p>
        <ul class="mt-3 space-y-3 text-muted-foreground">
          <li>
            <strong class="text-foreground">Affiliate / creator commission.</strong>
            A rate you set per product, paid only on sales creators drive.
            At a 20% commission it&rsquo;s more than three times the referral
            fee on the same sale.
          </li>
          <li>
            <strong class="text-foreground">Fulfillment or shipping.</strong>
            Either your own label and packing cost, or Fulfilled by TikTok (FBT),
            which charges per unit by chargeable weight, plus storage and return
            handling. Use the
            <a class={link} href="/tiktok-shop-fbt-fee-calculator/">FBT fee calculator</a>
            to get that figure. TikTok planned to phase out independent seller
            shipping in 2026 but
            <a class={link} href={SHIPPING_REVERSAL_URL} {...ext}>reversed the plan in February</a>,
            so shipping yourself is still an option.
          </li>
          <li>
            <strong class="text-foreground">Returns.</strong> The calculator
            treats a returned order as lost revenue, assuming the product and
            shipping aren&rsquo;t recovered. That&rsquo;s the conservative case.
          </li>
          <li>
            <strong class="text-foreground">Ad spend.</strong> Enter the total
            for the same batch of orders; the calculator spreads it per unit.
          </li>
          <li>
            <strong class="text-foreground">Product cost (COGS).</strong> Use
            landed cost, not the supplier price. See
            <a class={link} href="/how-to-calculate-cogs-tiktok-shop/">how to calculate COGS for TikTok Shop</a>.
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          Two products, same 6% fee, very different profit
        </h2>
        <p class="mt-3 text-muted-foreground">
          <strong class="text-foreground">The easy case</strong> (the
          calculator&rsquo;s defaults): a $50 product with a $15 cost, no
          creators, no ads, shipping built into the price. TikTok takes $3.00
          and you keep <strong class="text-foreground">$32.00 per order, a 64%
          margin</strong>. The referral fee barely matters here.
        </p>
        <p class="mt-3 text-muted-foreground">
          <strong class="text-foreground">The common case:</strong> a $20
          product costing $8, sold through creators at a 20% commission,
          shipped at $4 a label, with 5% of revenue refunded. Per order:
        </p>
        <ul class="mt-3 space-y-1 text-muted-foreground tabular-nums">
          <li>Referral fee (6%): $1.20</li>
          <li>Creator commission (20%): $4.00</li>
          <li>Shipping: $4.00</li>
          <li>Returns (5% of revenue): $1.00</li>
          <li>Product cost: $8.00</li>
          <li>You keep: <strong class="text-foreground">$1.80, a 9% margin</strong></li>
        </ul>
        <p class="mt-3 text-muted-foreground">
          The channel costs (referral, commission and shipping) take
          <strong class="text-foreground">46%</strong> of the price before the
          product is paid for. And the failure case: add $3 per order of ad
          spend and the same product <strong class="text-foreground">loses $1.20
          on every sale</strong>, with channel costs (now including ads) at 61% of revenue. Revenue
          looks the same in the TikTok dashboard in both cases.
        </p>
        <p class="mt-3 text-muted-foreground">
          If the answer is a loss, work backwards instead: the
          <a class={link} href="/tiktok-shop-break-even-calculator/">break-even price calculator</a>
          finds the price that covers these costs, and the
          <a class={link} href="/tiktok-shop-roas-calculator/">break-even ROAS calculator</a>
          tells you how efficient your ads need to be.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          Why the fee rates you read online disagree
        </h2>
        <p class="mt-3 text-muted-foreground">
          Search for TikTok Shop fees and you&rsquo;ll find guides quoting
          anything from 2% to 11%, per-category grids, and different
          &ldquo;new&rdquo; rates. None of the ones we checked in September 2026
          linked to a TikTok source. Some mix up markets, and some describe old
          category tables or new-seller promos whose official pages no longer
          exist.
        </p>
        <p class="mt-3 text-muted-foreground">
          The only authoritative source is TikTok&rsquo;s own
          <a class={link} href={REFERRAL_FEES_URL} {...ext}>referral fee page</a>
          and your Seller Center. TikTok&rsquo;s
          <a class={link} href={SELLER_TERMS_URL} {...ext}>Seller Terms</a>
          let it change the fee, with notice by email or in Seller Center.
          That&rsquo;s why the rate is an editable input here and not built
          in: if yours differs, change it and the whole result updates.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">Common questions</h2>
        <div class="mt-4 space-y-5">
          {
            faq.map((f) => (
              <div>
                <h3 class="font-semibold text-foreground">{f.q}</h3>
                <p class="mt-1.5 text-muted-foreground">{f.a}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">From estimate to real numbers</h2>
        <p class="mt-3 text-muted-foreground">
          This calculator models the fees. Your settlement shows what TikTok
          actually deducted, and it rarely matches revenue. See
          <a class={link} href="/why-tiktok-shop-payout-is-less-than-sales/">why your payout is less than your sales</a>
          and <a class={link} href="/tiktok-shop-payout-schedule/">when TikTok Shop pays you</a>,
          or browse all the <a class={link} href="/tools/">free seller tools</a>.
        </p>
        <p class="mt-4 text-sm text-muted-foreground">
          <a class={link} href="/">MarginReady</a> connects to your TikTok Shop
          account and shows true profit per SKU from your settled payouts,
          using the fees TikTok actually charged instead of modeled ones.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">Sources</h2>
        <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
          <li>
            <a class={link} href={REFERRAL_FEES_URL} {...ext}
              >TikTok Shop Seller Center: Referral Fees by Category</a
            >. The 6% standard rate, the 5% jewelry subcategories, pre-owned rates.
          </li>
          <li>
            <a class={link} href={SELLER_TERMS_URL} {...ext}
              >TikTok Shop Seller Terms of Service (US)</a
            >. What the referral fee covers, what it's calculated on, and TikTok's right to amend it.
          </li>
          <li>
            <a class={link} href={REFERRAL_TAX_URL} {...ext}
              >TikTok Shop Seller Center: Sales Tax on Referral Fees</a
            >. Texas and West Virginia, effective November 1, 2025.
          </li>
          <li>
            <a class={link} href={SHIPPING_REVERSAL_URL} {...ext}
              >Modern Retail: TikTok halts plan to end independent shipping for U.S. sellers</a
            >.
          </li>
        </ul>
      </section>
    </div>
  </div>
</Layout>
