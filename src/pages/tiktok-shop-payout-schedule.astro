---
import Layout from "../layouts/Layout.astro";
import { PayoutDateEstimator } from "../components/PayoutDateEstimator";

const site = "https://marginready.com";
const path = "/tiktok-shop-payout-schedule/";
const url = site + path;
const title = "TikTok Shop Payout Schedule — When Do You Actually Get Paid?";
const description =
  "When TikTok Shop actually pays you: 1–31 days after delivery by settlement tier, a 30-day reserve, and a $1 minimum. Work out the payout date for your own order.";

// Policy details verified against TikTok Shop Seller Center. Update when re-verified.
const verifiedAsOf = "September 2026";

const SETTLEMENT_POLICY_URL =
  "https://seller-us.tiktok.com/university/essay?knowledge_id=3995852763531009&lang=en";
const FINANCES_FAQ_URL =
  "https://seller-us.tiktok.com/university/essay?knowledge_id=2470273945257771&lang=en";

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: "TikTok Shop Payout Schedule — When Do You Actually Get Paid?",
  description,
  mainEntityOfPage: url,
  author: { "@id": "https://marginready.com/#organization" },
  publisher: { "@id": "https://marginready.com/#organization" },
};

const faq = [
  {
    q: "How long does TikTok Shop take to pay you?",
    a: "TikTok Shop initiates payout 1 to 31 days after an order's delivery date, depending on the settlement tier your shop is assigned. TikTok does not publish a fixed day count per tier. Your own timing is shown in Seller Center. After payout is initiated, bank processing typically adds 1 to 3 business days.",
  },
  {
    q: "When does the TikTok Shop settlement clock start?",
    a: "At delivery, not at checkout. An order settles once it has been delivered and there is no refund or return request still being processed against it. That's why a strong sales day doesn't turn into a payout on a predictable date: it depends on when those orders actually arrive.",
  },
  {
    q: "What are the TikTok Shop settlement tiers?",
    a: "There are five: Introductory for newly onboarded sellers or sellers on probation, Standard as the default for sellers out of probation, Accelerated and Express for stronger-performing shops (Express being the quickest available), and Deferred while TikTok Shop completes platform or seller security checks.",
  },
  {
    q: "Why is some of my TikTok Shop money still on hold?",
    a: "Either the order hasn't settled yet (not delivered, or a return or refund request is open), or it has settled and part of it is in reserve. TikTok holds a reserve against each delivered order for 30 days from the delivery date to cover returns and refunds, then releases whatever wasn't used.",
  },
  {
    q: "Do I have to request a TikTok Shop payout?",
    a: "No. Payouts are initiated automatically once your settled balance reaches the $1 minimum. Balances under $1 wait, and a negative balance is deducted from your next payout until the total clears $1.",
  },
  {
    q: "Why did my TikTok Shop payout fail?",
    a: "A Failed status means the transfer didn't reach your bank. Check the bank account under Finances > Payouts in Seller Center, since changes there apply to future payouts, then contact TikTok Shop seller support to have the failed transfer investigated. TikTok's documentation doesn't list specific failure reasons.",
  },
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};

const tiers = [
  {
    name: "Introductory",
    who: "Newly onboarded sellers, or sellers on probation",
  },
  {
    name: "Standard",
    who: "The default tier, applied automatically to sellers out of probation",
  },
  {
    name: "Accelerated",
    who: "Faster than Standard, based on shop performance",
  },
  { name: "Express", who: "The quickest settlement period available" },
  {
    name: "Deferred",
    who: "Applied while TikTok Shop completes platform and/or seller security checks",
  },
];
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="article" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="MarginReady" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(articleLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <header class="mb-8">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
        TikTok Shop payout schedule: when do you actually get paid?
      </h1>
      <p class="mt-4 text-muted-foreground">
        The short answer is a range, not a date:
        <strong class="text-foreground"
          >1 to 31 days after an order is delivered</strong
        >, depending on the settlement tier your shop sits in. The longer answer
        explains why your payouts feel unpredictable even when your sales
        aren&rsquo;t — and it comes down to three things most guides get wrong.
      </p>
      <p class="mt-3 text-xs text-muted-foreground">
        Policy details verified against TikTok Shop Seller Center as of {
          verifiedAsOf
        }. Confirm your own tier and timing in Seller Center — assignments are
        per-shop.
      </p>
    </header>

    <div class="mb-12">
      <PayoutDateEstimator client:load />
    </div>

    <div class="prose-tk space-y-12">
      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          The clock starts at delivery, not checkout
        </h2>
        <p class="mt-3 text-muted-foreground">
          This is the single biggest source of confusion. An order becomes
          eligible for settlement once it has been
          <strong class="text-foreground">delivered to the customer</strong> and
          there is no processing refund or return request against it. The date
          the customer paid you is irrelevant to your payout timing.
        </p>
        <p class="mt-3 text-muted-foreground">
          The practical consequence: a viral sales day doesn&rsquo;t produce a
          payout you can plan around. Those orders will settle scattered across
          however long delivery takes, and slow-shipping SKUs push their own
          revenue further out than fast ones. Two sellers with identical
          revenue can have very different cash positions purely because of
          carrier speed.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          Your settlement tier sets the speed
        </h2>
        <p class="mt-3 text-muted-foreground">
          TikTok Shop&rsquo;s Dynamic Settlement Policy defines five tiers. Where
          you land determines where in that 1–31 day window your payouts fall:
        </p>
        <div class="mt-4 overflow-x-auto">
          <table class="w-full text-sm border-collapse">
            <thead>
              <tr class="border-b border-border text-left">
                <th class="py-2 pr-4 font-semibold text-foreground">Tier</th>
                <th class="py-2 font-semibold text-foreground">Who gets it</th>
              </tr>
            </thead>
            <tbody>
              {
                tiers.map((t) => (
                  <tr class="border-b border-border align-top">
                    <td class="py-2 pr-4 font-medium text-foreground whitespace-nowrap">
                      {t.name}
                    </td>
                    <td class="py-2 text-muted-foreground">{t.who}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
        <p class="mt-4 text-muted-foreground">
          <strong class="text-foreground"
            >TikTok does not publish a fixed day count per tier.</strong
          > If you have read a guide confidently stating &ldquo;Standard is 8
          days&rdquo; or &ldquo;new sellers wait exactly 31,&rdquo; that
          precision isn&rsquo;t in the policy — the official documentation gives
          the 1–31 day range and describes the tiers qualitatively. Your actual
          timing is visible in Seller Center, and it is the only number worth
          planning against.
        </p>
        <p class="mt-3 text-muted-foreground">
          Tiers are not permanent. Seller evaluations run on the
          <strong class="text-foreground">1st day of every month</strong>,
          assigning both your settlement tier and reserve level for the period
          ahead. The inputs are your Shop Performance Score, orders successfully
          delivered over the previous 15–45 days, and any temporary account
          restrictions. Improve performance and you get paid faster; slip and
          you get paid slower.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          Reserves hold a slice for 30 more days
        </h2>
        <p class="mt-3 text-muted-foreground">
          Settlement isn&rsquo;t the end of it. TikTok Shop also retains a
          <strong class="text-foreground">reserve</strong> against delivered
          orders, held for <strong class="text-foreground">30 days from the
          delivery date</strong>, to cover returns and refunds that may still
          come. Unused reserve is released to you once those 30 days elapse.
        </p>
        <p class="mt-3 text-muted-foreground">
          There are three reserve levels, assigned in the same monthly
          evaluation as your settlement tier. This is why sellers routinely see
          a balance that looks like it should have arrived but hasn&rsquo;t: the
          order settled, and a portion of it is sitting in reserve on a separate
          30-day clock.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          Reading the Finances page
        </h2>
        <p class="mt-3 text-muted-foreground">
          Your money sits in one of three states, and knowing which is which
          makes the timing far less mysterious:
        </p>
        <ul class="mt-3 space-y-3 text-muted-foreground">
          <li>
            <strong class="text-foreground">On Hold</strong> — unsettled orders
            still awaiting delivery or settlement.
          </li>
          <li>
            <strong class="text-foreground">Processing</strong> — payout
            initiated but not yet in your bank. Bank processing typically adds
            1–3 business days on top of settlement.
          </li>
          <li>
            <strong class="text-foreground">Paid</strong> — transferred
            successfully.
          </li>
          <li>
            <strong class="text-foreground">Failed</strong> — the transfer
            didn&rsquo;t reach your bank. Check the account under Finances &gt;
            Payouts and contact seller support.
          </li>
        </ul>
        <p class="mt-3 text-muted-foreground">
          You don&rsquo;t request payouts. TikTok starts them automatically
          once your settled balance reaches the minimum.
        </p>
        <p class="mt-3 text-muted-foreground">
          One more rule catches people out: there is a
          <strong class="text-foreground">$1 minimum payout</strong>. Anything
          below that is not paid out, and negative balances are deducted from
          your next payout until the total clears $1.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          Three orders, three payout dates
        </h2>
        <p class="mt-3 text-muted-foreground">
          Take a shop whose Seller Center settlement period is 10 days, and
          three orders all placed on Monday, September 7, 2026:
        </p>
        <ul class="mt-3 space-y-3 text-muted-foreground">
          <li>
            <strong class="text-foreground">Order A, delivered Thursday Sept 10.</strong>
            Payout starts Sunday Sept 20 and reaches the bank between Monday
            Sept 21 and Wednesday Sept 23. Its reserve is released Saturday
            Oct 10.
          </li>
          <li>
            <strong class="text-foreground">Order B, same day, slow carrier, delivered Tuesday Sept 15.</strong>
            Everything shifts five days: payout starts Sept 25 and the reserve
            is released Oct 15. Same order date, same tier, a different week
            for the cash.
          </li>
          <li>
            <strong class="text-foreground">Order C, delivered Sept 10, but the buyer opens a return on Sept 12.</strong>
            It doesn&rsquo;t settle on Sept 20 with order A. It stays On Hold
            until the return is resolved, and if the refund goes through there
            is nothing to pay out. That&rsquo;s the failure case the reserve
            exists for.
          </li>
        </ul>
        <p class="mt-3 text-muted-foreground">
          Put your own delivery dates into the estimator above to get the same
          breakdown.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          Payout late? Check these in order
        </h2>
        <ol class="mt-3 list-decimal space-y-3 pl-5 text-muted-foreground">
          <li>
            <strong class="text-foreground">Was it actually delivered?</strong>
            The clock starts at delivery. An order stuck in transit hasn&rsquo;t
            started counting.
          </li>
          <li>
            <strong class="text-foreground">Is there an open return or refund request?</strong>
            The order won&rsquo;t settle until it&rsquo;s resolved.
          </li>
          <li>
            <strong class="text-foreground">Has your tier changed?</strong>
            Tiers are reassigned on the 1st of each month. A drop in Shop
            Performance Score, or a temporary restriction, can move you to a
            slower tier. Deferred applies during security checks.
          </li>
          <li>
            <strong class="text-foreground">Is the missing amount the reserve?</strong>
            Part of a settled order is held for 30 days from delivery.
          </li>
          <li>
            <strong class="text-foreground">Is the balance under $1, or negative?</strong>
            Nothing pays out until the total clears $1, and a negative balance
            is taken out of the next payout first.
          </li>
          <li>
            <strong class="text-foreground">Is it Processing or Failed?</strong>
            Processing is normal for 1–3 business days. Failed means check your
            bank details under Finances &gt; Payouts, then contact support.
          </li>
        </ol>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          What this means for planning
        </h2>
        <p class="mt-3 text-muted-foreground">
          Between delivery-based settlement, a performance-assigned tier, and a
          30-day reserve, the gap between &ldquo;I made a sale&rdquo; and
          &ldquo;the full amount is in my account&rdquo; is genuinely long and
          genuinely variable. Restocking against your GMV figure is how sellers
          end up short on cash while nominally profitable.
        </p>
        <p class="mt-3 text-muted-foreground">
          It also means the payout that eventually arrives will not match the
          revenue you remember — that gap has its own causes, covered in
          <a
            class="underline hover:text-foreground"
            href="/why-tiktok-shop-payout-is-less-than-sales/"
            >why your TikTok Shop payout is less than your sales</a
          >.
        </p>
        <p class="mt-4 text-sm text-muted-foreground">
          <a class="underline hover:text-foreground" href="/">MarginReady</a>
          reads your actual settled payouts through TikTok&rsquo;s Finance API and
          shows true profit per SKU — settled numbers, not estimates. To model a
          product before you sell it, try the <a
            class="underline hover:text-foreground"
            href="/tiktok-shop-fee-calculator/">fee calculator</a
          >, or browse all the <a
            class="underline hover:text-foreground"
            href="/tools/">free seller tools</a
          >.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">Common questions</h2>
        <div class="mt-4 space-y-5">
          {
            faq.map((f) => (
              <div>
                <h3 class="font-semibold text-foreground">{f.q}</h3>
                <p class="mt-1.5 text-muted-foreground">{f.a}</p>
              </div>
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">Sources</h2>
        <ul class="mt-3 space-y-2 text-sm text-muted-foreground">
          <li>
            <a
              class="underline hover:text-foreground"
              href={SETTLEMENT_POLICY_URL}
              rel="nofollow noopener"
              target="_blank">TikTok Shop Seller Center — Dynamic Settlement and Reserve Policy</a
            > — settlement tiers, reserve duration and levels, monthly evaluation.
          </li>
          <li>
            <a
              class="underline hover:text-foreground"
              href={FINANCES_FAQ_URL}
              rel="nofollow noopener"
              target="_blank">TikTok Shop Seller Center — Finances Page FAQ</a
            > — 1–31 day payout window, 1–3 day bank processing, $1 minimum and automatic payouts, On Hold / Processing / Paid / Failed states, bank account settings.
          </li>
        </ul>
      </section>
    </div>
  </div>
</Layout>
