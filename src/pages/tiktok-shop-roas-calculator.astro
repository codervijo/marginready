---
import Layout from "../layouts/Layout.astro";
import { RoasCalculator } from "../components/RoasCalculator";

const site = "https://marginready.com";
const path = "/tiktok-shop-roas-calculator/";
const url = site + path;
const title =
  "TikTok Shop Break-Even ROAS Calculator — What ROAS Do You Need?";
const description =
  "Free break-even ROAS calculator for TikTok Shop ads. Enter your price, COGS, referral fee, affiliate commission, fulfillment, and returns to find your break-even ROAS, the ROAS for your target margin, and your max cost per order.";

// Rates confirmed against TikTok Shop Seller Center. Update this date when re-verified.
const ratesAsOf = "July 2026";

const webApplicationLd = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  name: "TikTok Shop Break-Even ROAS Calculator",
  url,
  description:
    "Calculate break-even ROAS, target-margin ROAS, and maximum cost per order for TikTok Shop ads based on your real unit economics.",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  offers: {
    "@type": "Offer",
    price: "0",
    priceCurrency: "USD",
  },
  publisher: { "@id": "https://marginready.com/#organization" },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "What is break-even ROAS on TikTok Shop?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Break-even ROAS is 1 divided by your contribution margin rate — the share of each revenue dollar left after every non-ad cost (referral fee, affiliate commission, returns, COGS, fulfillment). If 64 cents of every dollar survives those costs, your break-even ROAS is 1 ÷ 0.64 = 1.56x. Below that, each ad dollar loses money.",
      },
    },
    {
      "@type": "Question",
      name: "Is a 2x ROAS good on TikTok Shop?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "It depends entirely on your margins — 2x is not universally good or bad. A product with a 50% contribution margin breaks even at exactly 2x, so 2x earns nothing. A product with a 25% contribution margin needs 4x just to break even, so 2x is a heavy loss. Compute your own break-even before judging any ROAS number.",
      },
    },
    {
      "@type": "Question",
      name: "Why is my TikTok Shop ROAS profitable but my bank account isn't?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "TikTok Ads Manager measures ROAS against gross revenue, before the referral fee, affiliate commissions, returns, COGS, and fulfillment come out. A campaign showing a healthy ROAS can still be unprofitable once those land. Break-even ROAS is the threshold that accounts for all of them.",
      },
    },
    {
      "@type": "Question",
      name: "How do I calculate max cost per order for TikTok Shop ads?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "Your maximum cost per order at break-even equals your contribution per order — price minus referral fee, affiliate commission, returns, COGS, and fulfillment. To keep a target margin instead, subtract that margin's dollar value from the contribution.",
      },
    },
  ],
};
---

<Layout>
  <Fragment slot="head">
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:site_name" content="MarginReady" />

    <!-- Twitter card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- JSON-LD structured data -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(webApplicationLd)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqLd)} />
  </Fragment>

  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
    <header class="mb-6">
      <h1 class="text-3xl sm:text-4xl font-semibold tracking-tight">
        TikTok Shop Break-Even ROAS Calculator
      </h1>
      <p class="mt-3 text-muted-foreground max-w-2xl">
        Ads Manager reports ROAS against gross revenue — before the referral
        fee, creator commissions, returns, and your product cost come out. Enter
        your real unit economics to find the ROAS you actually need, and what
        the ROAS you&rsquo;re getting today is really earning you.
      </p>
      <p class="mt-3 text-xs text-muted-foreground">
        Rates current as of {ratesAsOf}; confirm your category in TikTok Seller
        Center. This estimator uses your inputs — it does not read your account.
      </p>
    </header>

    <RoasCalculator client:load />

    <div class="prose-tk mt-14 space-y-12 max-w-3xl">
      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          What is break-even ROAS?
        </h2>
        <p class="mt-3 text-muted-foreground">
          Break-even ROAS is the return on ad spend at which your net profit is
          exactly zero. It falls straight out of one number — your
          <strong class="text-foreground">contribution margin rate</strong>, the
          share of each revenue dollar left after every cost that isn&rsquo;t
          advertising:
        </p>
        <p
          class="mt-3 rounded-lg border border-border bg-muted/40 px-4 py-3 text-sm text-foreground tabular-nums"
        >
          break-even ROAS = 1 ÷ contribution margin rate
        </p>
        <p class="mt-3 text-muted-foreground">
          Take a $50 product with $15 COGS and the standard US 6% referral fee.
          Contribution is $50 &minus; $3 &minus; $15 =
          <strong class="text-foreground">$32</strong>, or 64% of revenue. Your
          break-even ROAS is 1 ÷ 0.64 =
          <strong class="text-foreground">1.56×</strong>. Anything below that and
          the campaign is spending more than the orders are worth.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          Is 2× ROAS good on TikTok Shop?
        </h2>
        <p class="mt-3 text-muted-foreground">
          There is no answer to this without your margins, which is why the
          question circulates endlessly in seller groups with contradictory
          replies. The same 2× is three different outcomes:
        </p>
        <ul class="mt-3 space-y-3 text-muted-foreground">
          <li>
            At a <strong class="text-foreground">64% contribution margin</strong>,
            break-even is 1.56× — so 2× is genuinely profitable.
          </li>
          <li>
            At a <strong class="text-foreground">50% contribution margin</strong>,
            break-even is exactly 2× — so 2× earns you nothing at all.
          </li>
          <li>
            At a <strong class="text-foreground">25% contribution margin</strong>,
            break-even is 4× — so 2× is losing roughly a quarter of revenue on
            every order.
          </li>
        </ul>
        <p class="mt-3 text-muted-foreground">
          Add a 20% creator commission to that first product and its
          contribution rate falls from 64% to 44%, pushing break-even from 1.56×
          to <strong class="text-foreground">2.27×</strong>. The campaign
          didn&rsquo;t change; the bar did.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          ROAS for a target margin
        </h2>
        <p class="mt-3 text-muted-foreground">
          Break-even is survival, not a business. To keep a specific net margin,
          subtract it from the contribution rate before dividing:
        </p>
        <p
          class="mt-3 rounded-lg border border-border bg-muted/40 px-4 py-3 text-sm text-foreground tabular-nums"
        >
          target ROAS = 1 ÷ (contribution margin rate &minus; target net margin)
        </p>
        <p class="mt-3 text-muted-foreground">
          The same identity read backwards tells you what your current campaigns
          are really doing:
          <span class="text-foreground"
            >net margin = contribution rate &minus; 1 ÷ ROAS</span
          >. Enter the ROAS you see in Ads Manager and the calculator converts it
          into the margin it actually produces.
        </p>
        <p class="mt-3 text-muted-foreground">
          Note that a target margin above your contribution rate is unreachable
          at <em>any</em> ROAS — even free traffic wouldn&rsquo;t get you there,
          because the gap is in the unit economics, not the ads.
        </p>
      </section>

      <section>
        <h2 class="text-2xl font-semibold tracking-tight">
          Max cost per order — the number to actually bid against
        </h2>
        <p class="mt-3 text-muted-foreground">
          ROAS is a ratio, and ratios are awkward to act on when you&rsquo;re
          setting bids. The dollar version is easier: the most you can pay to
          acquire one order and still break even is simply your
          <strong class="text-foreground">contribution per order</strong> — $32
          in the example above. Want to keep a 15% net margin on a $50 order
          instead? Subtract $7.50, leaving
          <strong class="text-foreground">$24.50</strong> as your ceiling.
        </p>
        <p class="mt-4 text-sm text-muted-foreground">
          Working out what price supports your ad costs in the first place? Use
          the <a
            class="underline hover:text-foreground"
            href="/tiktok-shop-break-even-calculator/"
            >break-even price calculator</a
          >. For profit at a price you have already set, use the <a
            class="underline hover:text-foreground"
            href="/tiktok-shop-fee-calculator/">TikTok Shop fee calculator</a
          >. And once orders are settling, <a
            class="underline hover:text-foreground"
            href="/">MarginReady</a
          > shows true profit per SKU from your real settled payouts instead of estimates.
        </p>
      </section>
    </div>
  </div>
</Layout>
